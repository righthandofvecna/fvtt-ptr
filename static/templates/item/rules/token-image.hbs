<div class="form-group">
    <label class="short">Image Path</label>
    <div class="image-value-row d-flex flex-row">
        <input type="text" name="system.rules.{{index}}.value" value="{{rule.value}}" placeholder="Path to image file"/>
        <a data-action="browse-image" title="Browse files"><i class="fas fa-file-image"></i></a>
        {{#if previewValid}}
            <img src="{{rule.value}}" title="{{rule.value}}" style="width:24px;height:24px;object-fit:contain;flex-shrink:0;"/>
        {{/if}}
    </div>
</div>

<div class="form-group">
    <label class="short">Scale</label>
    <div class="attached-input">
        <input type="number" min="0.1" step="0.1" name="system.rules.{{index}}.scale" value="{{rule.scale}}" placeholder="1.0"/>
    </div>
</div>

<div class="form-group">
    <label class="short">Tint</label>
    <div class="attached-input">
        <input type="text" name="system.rules.{{index}}.tint" value="{{rule.tint}}" placeholder="#rrggbb"/>
    </div>
</div>

<div class="form-group">
    <label class="short">Alpha</label>
    <div class="attached-input">
        <input type="number" min="0" max="1" step="0.05" name="system.rules.{{index}}.alpha" value="{{rule.alpha}}" placeholder="0–1"/>
    </div>
</div>

<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.General.Predicate"}}</label>
    <div class="attached-input">
        <button type="button" class="attachment" data-action="toggle-predicate">
            {{#if predicationIsMultiple}}Multiple{{else}}Complex{{/if}}
        </button>
        {{#if predicationIsMultiple}}
            <input type="text" class="ptu-tagify predicate-list" name="system.rules.{{index}}.predicate" value="{{json rule.predicate}}" data-dtype="JSON"/>
        {{else}}
            <input type="text" name="system.rules.{{index}}.predicate" value="{{json rule.predicate}}" />
        {{/if}}
    </div>
</div>
