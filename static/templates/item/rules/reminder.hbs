{{!-- Affects --}}
<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.General.Affects"}}</label>
    <div class="d-flex flex-row justify-content-evenly">
        <label title="{{localize "PTU.RuleEditor.Reminder.AffectsTargetHint"}}">
            {{localize "PTU.RuleEditor.General.Target"}}
            <input type="radio" name="system.rules.{{index}}.affects" value="target" {{#if (is rule.affects "target")}}checked{{/if}}>
        </label>
        <label title="{{localize "PTU.RuleEditor.Reminder.AffectsOriginHint"}}">
            {{localize "PTU.RuleEditor.General.Origin"}}
            <input type="radio" name="system.rules.{{index}}.affects" value="origin" {{#if (is rule.affects "origin")}}checked{{/if}}>
        </label>
    </div>
    <p class="hint">
        {{#if (is rule.affects "target")}}
            {{localize "PTU.RuleEditor.Reminder.AffectsTargetHint"}}
        {{else}}
            {{localize "PTU.RuleEditor.Reminder.AffectsOriginHint"}}
        {{/if}}
    </p>
</div>

{{!-- Selectors --}}
<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.General.Selectors"}}</label>
    <div class="attached-input">
        <button type="button" class="attachment" data-action="toggle-selector">
            {{#if selectorIsArray}}Multiple{{else}}Single{{/if}}
        </button>
        {{#if selectorIsArray}}
            <input type="text" class="ptu-tagify selectors-list" name="system.rules.{{index}}.selectors" value="{{json rule.selectors}}" data-dtype="JSON"/>
        {{else}}
            <input type="text" name="system.rules.{{index}}.selectors" value="{{rule.selectors}}" />
        {{/if}}
    </div>
    <p class="hint">{{localize "PTU.RuleEditor.Reminder.SelectorsHint"}}</p>
</div>

{{!-- Message --}}
<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.Reminder.Message"}}</label>
    <div class="spaced-fields details-container-flex-row">
        <textarea name="system.rules.{{index}}.message" rows="3">{{rule.message}}</textarea>
    </div>
    <p class="hint">{{localize "PTU.RuleEditor.Reminder.MessageHint"}}</p>
</div>

{{!-- Frequency --}}
<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.Reminder.Frequency.Label"}}</label>
    <div class="spaced-fields details-container-flex-row">
        <select name="system.rules.{{index}}.frequency">
            <option value="always" {{#if (is rule.frequency "always")}}selected{{/if}}>{{localize "PTU.RuleEditor.Reminder.Frequency.Always"}}</option>
            <option value="once-per-combat" {{#if (is rule.frequency "once-per-combat")}}selected{{/if}}>{{localize "PTU.RuleEditor.Reminder.Frequency.OncePerCombat"}}</option>
            <option value="once-per-rest" {{#if (is rule.frequency "once-per-rest")}}selected{{/if}}>{{localize "PTU.RuleEditor.Reminder.Frequency.OncePerRest"}}</option>
        </select>
    </div>
</div>

{{!-- Message Predicate --}}
<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.Reminder.MessagePredicate"}}</label>
    <div class="attached-input">
        <button type="button" class="attachment" data-action="toggle-predicate">
            {{#if predicationIsMultiple}}Multiple{{else}}Complex{{/if}}
        </button>
        {{#if predicationIsMultiple}}
            <input type="text" class="ptu-tagify predicate-list" name="system.rules.{{index}}.messagePredicate" value="{{json rule.messagePredicate}}" data-dtype="JSON"/>
        {{else}}
            <input type="text" name="system.rules.{{index}}.messagePredicate" value="{{json rule.messagePredicate}}" />
        {{/if}}
    </div>
    <p class="hint">{{localize "PTU.RuleEditor.Reminder.MessagePredicateHint"}}</p>
</div>


{{!-- Predicate --}}
<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.General.Predicate"}}</label>
    <div class="attached-input">
        <button type="button" class="attachment" data-action="toggle-predicate">
            {{#if predicationIsMultiple}}Multiple{{else}}Complex{{/if}}
        </button>
        {{#if predicationIsMultiple}}
            <input type="text" class="ptu-tagify predicate-list" name="system.rules.{{index}}.predicate" value="{{json rule.predicate}}" data-dtype="JSON"/>
        {{else}}
            <input type="text" name="system.rules.{{index}}.predicate" value="{{json rule.predicate}}" />
        {{/if}}
    </div>
    <p class="hint">{{localize "PTU.RuleEditor.Reminder.PredicateHint"}}</p>
</div>
