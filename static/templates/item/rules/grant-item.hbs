<div class="d-flex flex-row justify-content-between">
    <label class="fill">
        {{localize "PTU.RuleEditor.GrantItem.AllowDuplicate"}}
        <input type="checkbox" name="system.rules.{{index}}.allowDuplicate" {{checked allowDuplicate}}>
    </label>
    <label class="fill">
        {{localize "PTU.RuleEditor.GrantItem.ReplaceSelf"}}
        <input type="checkbox" name="system.rules.{{index}}.replaceSelf" {{checked rule.replaceSelf}}>
    </label>
    <label class="fill">
        {{localize "PTU.RuleEditor.GrantItem.ReevaluateOnUpdate"}}
        <input type="checkbox" name="system.rules.{{index}}.reevaluateOnUpdate" {{checked rule.reevaluateOnUpdate}}>
    </label>
</div>
<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.General.UUID"}}</label>
    <div class="d-flex flex-row">
        <input type="text" name="system.rules.{{index}}.uuid" value="{{rule.uuid}}" />
        {{#if granted}}
            <a class="granted content-link ml-1" data-uuid="{{granted.uuid}}">
                <img src="{{granted.img}}"/>
                {{granted.name}}
            </a>
        {{/if}}
    </div>

</div>
<div class="form-group">
    <label class="short">{{localize "PTU.RuleEditor.General.Predicate"}}</label>
    <div class="attached-input">
        <button type="button" class="attachment" data-action="toggle-predicate">
            {{#if predicationIsMultiple}}Multiple{{else}}Complex{{/if}}
        </button>
        {{#if predicationIsMultiple}}
            <input type="text" class="ptu-tagify predicate-list" name="system.rules.{{index}}.predicate" value="{{json rule.predicate}}" data-dtype="JSON"/>
        {{else}}
            <input type="text" name="system.rules.{{index}}.predicate" value="{{json rule.predicate}}" />
        {{/if}}
    </div>
</div>
<div class="form-group modifications-section">
    <label class="short">Modifications</label>
    <div class="modifications-list">
        {{#each rule.modifications as |mod idx|}}
        <div class="d-flex flex-row spaced-fields modification-entry" data-idx="{{idx}}">
            <input type="text"
                name="system.rules.{{@root.index}}.modifications.{{idx}}.key"
                value="{{mod.key}}"
                placeholder="system.path" />
            <select name="system.rules.{{@root.index}}.modifications.{{idx}}.operation">
                <option value="add"       {{isSelected mod.operation "add"}}>Add</option>
                <option value="subtract"  {{isSelected mod.operation "subtract"}}>Subtract</option>
                <option value="remove"    {{isSelected mod.operation "remove"}}>Remove</option>
                <option value="multiply"  {{isSelected mod.operation "multiply"}}>Multiply</option>
                <option value="override"  {{isSelected mod.operation "override"}}>Override</option>
                <option value="upgrade"   {{isSelected mod.operation "upgrade"}}>Upgrade</option>
                <option value="downgrade" {{isSelected mod.operation "downgrade"}}>Downgrade</option>
            </select>
            <input type="text"
                name="system.rules.{{@root.index}}.modifications.{{idx}}.value"
                value="{{mod.value}}"
                placeholder="value or JSON" />
            <a data-action="modification-delete" data-idx="{{idx}}">×</a>
        </div>
        {{/each}}
        <a data-action="modification-add">+ Add Modification</a>
    </div>
</div>