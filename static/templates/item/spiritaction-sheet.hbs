{{!-- Form Element --}}
<form class="item-sheet {{cssClass}}" autocomplete="off">
    <header class="sheet-header sheet-tabs" data-group="primary" style="background: #AED3A2;">
        <nav class="tabs" data-group="primary">
            <a class="item tooltip ball-themes nest" title="Overview" data-tab="overview"><i class="fas fa-house"></i></a>
            <a class="item tooltip ball-themes nest" title="Details" data-tab="details"><i class="fas fa-gear"></i></a>
            <a class="item tooltip ball-themes nest" title="Rules" data-tab="rules"><i class="fas fa-toolbox"></i></a>
        </nav>
    </header>

    <div class="sheet-body h-100 w-100">
        {{!-- Sheet Header --}}
        <header class="header w-100 p-2">
            <input
                name="name"
                type="text"
                value="{{item.name}}"
                placeholder="Name"
                {{#if editLocked}}disabled{{/if}}
            />
        </header>
        <div class="tab overview h-100" data-group="primary" data-tab="overview">
            <div class="move-row p-2">
                <div class="move-column">
                    <div class="avatar ml-3 mr-4 mt-2 mb-2">
                        <img class="p-2 content {{#unless editLocked}}profile-img{{/unless}}" src="{{data.img}}" {{#unless editLocked}}data-edit="img"{{/unless}} title="{{name}}"/>
                    </div>
                    <div class="origin-box">
                        <input
                            name=""
                            type="text"
                            value="{{item.system.origin}}"
                            placeholder="Origin"
                            disabled
                        />
                    </div>
                </div>

                <div class="move-info ml-3">
                    <div class="move-info-row">
                        <div class="move-info-col">
                            <div class="move-other-info mt-2">
                                <span>
                                    FREQ 
                                    <input
                                        class="ml-1 mr-1"
                                        type="text"
                                        value="{{shortFrequency item.system.frequency}}"
                                        disabled
                                    />
                                    {{#if eotCooldown}}
                                    <button type="button" data-action="resetEOT" class="ml-1" data-tooltip="ITEM.ResetEOT"><i class="fas fa-undo"></i></button>
                                    {{/if}}
                                </span>
                                <span style="flex: 0 0 100%;">
                                    TRIGGER 
                                    <input
                                        class="ml-2"
                                        name=""
                                        type="text"
                                        value="{{item.system.trigger}}"
                                        placeholder=""
                                        disabled
                                    />
                                </span>
                                <span style="flex: 0 0 100%">
                                    COST 
                                    <input
                                        class="ml-2"
                                        name=""
                                        type="number"
                                        value="{{item.system.cost}}"
                                        placeholder=""
                                        disabled
                                    />
                                </span>
                                <span style="flex: 0 0 100%;">
                                    ACTIVE
                                    <input
                                        class="ml-2 mr-2"
                                        type="checkbox" {{checked item.system.active}}
                                        disabled
                                    />
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="move-row" style="flex-grow: 1">
                <div class="move-effect">{{{itemEffect}}}{{#if referenceEffect}}<br><br>{{{referenceEffect}}}{{/if}}</div>
            </div>
        </div>
        <div class="tab details h-100" data-group="primary" data-tab="details">
            <div class="item-row">
                <label for="system.frequency.type">{{localize "ITEM.Frequency"}}</label>
                <select class="ml-1 mr-1" name="system.frequency.type" {{#if editLocked}}disabled{{/if}}>
                    {{selectOptions config.frequencies selected=item.system.frequency.type localize=true}}
                </select>
                {{#if (or (is item.system.frequency.type "scene") (is item.system.frequency.type "daily"))}}
                <input class="ml-1 frequency" name="system.frequency.max" type="number" value="{{item.system.frequency.max}}" style="flex: 0.25;" min="1" {{#if editLocked}}disabled{{/if}}/><label class="unit">Max Uses</label>
                <input class="ml-1 used" name="flags.ptu.used" type="number" value="{{item.flags.ptu.used}}" style="flex: 0.25;" min="0" max="{{item.system.frequency.max}}" {{#if editLocked}}disabled{{/if}}/><label class="unit">Used</label>
                {{/if}}
            </div>
            <div class="item-row">
                <label>{{localize "ITEM.ActionCost"}}</label>
                <div class="d-flex ml-1" style="gap: 0.5rem; flex-wrap: wrap;">
                    <label>{{localize "PTU.ActionCost.Standard"}}</label>
                    <input type="checkbox" name="system.actionCost.standard" {{checked item.system.actionCost.standard}} {{#if editLocked}}disabled{{/if}}/>
                    <label>{{localize "PTU.ActionCost.Rapid"}}</label>
                    <input type="checkbox" name="system.actionCost.rapid" {{checked item.system.actionCost.rapid}} {{#if editLocked}}disabled{{/if}}/>
                    <label>{{localize "PTU.ActionCost.Shift"}}</label>
                    <input type="checkbox" name="system.actionCost.shift" {{checked item.system.actionCost.shift}} {{#if editLocked}}disabled{{/if}}/>
                    <label>{{localize "PTU.ActionCost.Free"}}</label>
                    <input type="checkbox" name="system.actionCost.free" {{checked item.system.actionCost.free}} {{#if editLocked}}disabled{{/if}}/>
                    <label>{{localize "PTU.ActionCost.Extended"}}</label>
                    <input type="checkbox" name="system.actionCost.extended" {{checked item.system.actionCost.extended}} {{#if editLocked}}disabled{{/if}}/>
                </div>
            </div>
            <div class="item-row">
                <label for="system.ap">{{localize "ITEM.AP"}}</label>
                <input class="ml-1 mr-1" name="system.ap" type="number" value="{{item.system.ap}}" placeholder="0" min="0" {{#if editLocked}}disabled{{/if}}/>
            </div>
            <div class="item-row">
                <label for="system.trigger">{{localize "ITEM.Trigger"}}</label>
                <input class="ml-1 mr-1" name="system.trigger" type="text" value="{{item.system.trigger}}" placeholder="{{localize "ITEM.Trigger"}}"/>
            </div>
            <div class="item-row">
                <label for="system.cost">{{localize "ITEM.Cost"}}</label>
                <input class="ml-1 mr-1" name="system.cost" type="text" value="{{item.system.cost}}" placeholder="{{localize "ITEM.Cost"}}"/>
            </div>
            <div class="item-row">
                <label for="system.origin">{{localize "ITEM.Origin"}}</label>
                <input class="ml-1 mr-1" name="system.origin" type="text" value="{{item.system.origin}}" placeholder="{{localize "ITEM.Origin"}}"/>
            </div>
            <div class="item-row">
                <label for="system.effect">{{localize "ITEM.Effect"}}</label>
                <textarea class="ml-1 mr-1" name="system.effect">{{item.system.effect}}</textarea>
            </div>
            <div class="item-row" style="justify-content: flex-start;">
                <label for="system.active">{{localize "ITEM.ActiveAction"}}</label>
                <input class="ml-1 mr-1" name="system.active" type="checkbox" {{checked item.system.active}}/>
            </div>
        </div>
        <div class="tab rules h-100" data-group="primary" data-tab="rules">
            {{~> systems/ptu/static/templates/partials/rules/rule-partial.hbs item=item}}
        </div>
    </div>
</form>