<section class="token-panel">
    {{#if actor}}
    <div class="main-panel">
        <div class="avatar {{#if (eq actor.type "pokemon")}}pokemon{{/if}}">
            <img src="{{actor.img}}" alt="{{actor.name}}">
                {{!-- <div class="action">
                    <i class="fas fa-play" title="Standard Action"></i>
                </div>
                <div class="action">
                    <i class="fas fa-arrows-alt" title="Shift Action"></i>
                </div>
                <div class="action">
                    <i class="fas fa-asterisk" title="Swift Action"></i>
                </div> --}}
        </div>
        <div class="action-bar movement">
            {{#each movement as |move|}}
                <div class="movement-card">
                    <i class="{{move.icon}}" title="{{move.name}}"></i> {{move.value}}
                </div>
            {{/each}}
        </div>
        <div class="separator"></div>
        <div class="items-body">

            {{#if show.actions}}
            {{#if (gt attacks.length 0)}}
            {{#each attacks as |attack|}}
                <div class="action attack {{attack.typeClass}} {{#if attack.rollable}}rollable{{else}}sendtochat{{/if}} {{#if attack.onCooldown}}on-cooldown{{/if}}" data-id="{{attack.id}}"
                    data-tooltip="<div class='effect-popup'><div class='d-flex justify-content-center'><div class='effect-range'>{{attack.range}}</div>{{#each attack.keywords}}<div class='effect-range'>{{this}}</div>{{/each}}</div><div class='effect-effect'>{{attack.effect}}</div></div>" data-tooltip-direction="LEFT">
                    <div class="row-main">
                        <div class="icon-wrap">
                            <img class="move-img" src="{{attack.img}}" alt="{{attack.name}}">
                            <div class="dice-overlay">
                                {{#if attack.rollable}}
                                    <img src="/icons/svg/d20.svg" title="Roll {{attack.name}}" alt="Roll">
                                {{else}}
                                    <img src="systems/ptu/static/images/svg/chat.svg" title="Send {{attack.name}} to chat" alt="Chat">
                                {{/if}}
                            </div>
                        </div>
                        <div class="name">{{attack.name}}</div>
                        <div class="stat-chips">
                            {{#if attack.ac}}<div class="chip ac" title="Accuracy Check">AC {{attack.ac}}</div>{{/if}}
                            {{#if attack.db}}<div class="chip db" title="Damage Base">DB {{attack.db}}</div>{{/if}}
                        </div>
                        {{#if (gt attack.actionCostIcons.length 0)}}
                        <div class="action-costs">
                            {{#each attack.actionCostIcons}}<ptu-icon src="{{this.src}}" title="{{this.label}}" class="cost-icon" alt="{{this.label}}"></ptu-icon>{{/each}}
                        </div>
                        {{/if}}
                    </div>
                    <div class="row-meta">
                        {{#if attack.category}}<img class="category-icon" src="{{attack.category}}" title="Category" alt="Category">{{/if}}
                        {{#if attack.frequency}}<div class="freq-tag">{{shortFrequency attack}}</div>{{/if}}
                        {{#if attack.effectiveness}}{{#unless (eq attack.effectiveness.key "normal")}}<div class="eff-pill {{attack.effectiveness.key}}">{{attack.effectiveness.label}}</div>{{/unless}}{{/if}}
                        {{#if attack.usageDisplay}}<div class="usage-badge">{{#if attack.usageDisplay.limited}}<span>{{attack.usageDisplay.remaining}}/{{attack.usageDisplay.max}} Uses</span>{{/if}}{{#if attack.usageDisplay.eot}}<span>EOT</span>{{/if}}</div>{{/if}}
                    </div>
                </div>
            {{/each}}
            {{/if}}
            {{#if (gt struggles.length 0)}}
            {{#each struggles as |struggle|}}
            <div class="action struggle {{struggle.typeClass}} {{#if struggle.rollable}}rollable{{else}}sendtochat{{/if}} {{#if struggle.onCooldown}}on-cooldown{{/if}}" data-id="{{struggle.id}}">
                <div class="row-main">
                    <div class="icon-wrap">
                        <img class="move-img" src="{{struggle.img}}" alt="{{struggle.name}}">
                        <div class="dice-overlay">
                            {{#if struggle.rollable}}
                                <img src="/icons/svg/d20.svg" title="Roll {{struggle.name}}" alt="Roll">
                            {{else}}
                                <img src="systems/ptu/static/images/svg/chat.svg" title="Send {{struggle.name}} to chat" alt="Chat">
                            {{/if}}
                        </div>
                    </div>
                    <div class="name">{{struggle.name}}</div>
                    <div class="stat-chips">
                        {{#if struggle.ac}}<div class="chip ac" title="Accuracy Check">AC {{struggle.ac}}</div>{{/if}}
                        {{#if struggle.db}}<div class="chip db" title="Damage Base">DB {{struggle.db}}</div>{{/if}}
                    </div>
                    {{#if (gt struggle.actionCostIcons.length 0)}}
                    <div class="action-costs">
                        {{#each struggle.actionCostIcons}}<ptu-icon src="{{this.src}}" title="{{this.label}}" class="cost-icon" alt="{{this.label}}"></ptu-icon>{{/each}}
                    </div>
                    {{/if}}
                </div>
                <div class="row-meta">
                    {{#if struggle.category}}<img class="category-icon" src="{{struggle.category}}" title="Category" alt="Category">{{/if}}
                    {{#if struggle.frequency}}<div class="freq-tag">{{shortFrequency struggle}}</div>{{/if}}
                    {{#if struggle.effectiveness}}{{#unless (eq struggle.effectiveness.key "normal")}}<div class="eff-pill {{struggle.effectiveness.key}}">{{struggle.effectiveness.label}}</div>{{/unless}}{{/if}}
                    {{#if struggle.usageDisplay}}<div class="usage-badge">{{#if struggle.usageDisplay.limited}}<span>{{struggle.usageDisplay.remaining}}/{{struggle.usageDisplay.max}} Uses</span>{{/if}}{{#if struggle.usageDisplay.eot}}<span>EOT</span>{{/if}}</div>{{/if}}
                </div>
            </div>
            {{/each}}
            {{/if}}
            {{/if}}

            {{#if (and (and (is actor.type "character") show.feats) (gt feats.length 0))}}
            {{#each feats as |feat|}}
                <div class="action feat {{#if feat.rollable}}rollable{{else}}sendtochat{{/if}} {{#if feat.onCooldown}}on-cooldown{{/if}}" data-id="{{feat.id}}"
                    data-tooltip="<div class='effect-popup'>{{#if feat.keywords}}<div class='d-flex justify-content-center'>{{#each feat.keywords}}<div class='effect-range'>{{this}}</div>{{/each}}</div>{{/if}}<div class='effect-effect'>{{feat.effect}}</div></div>" data-tooltip-direction="LEFT">
                    <div class="row-main">
                        <div class="icon-wrap">
                            <img class="move-img" src="{{feat.img}}" alt="{{feat.name}}">
                            <div class="dice-overlay">
                                {{#if feat.rollable}}
                                    <img src="/icons/svg/d20.svg" title="Roll {{feat.name}}" alt="Roll">
                                {{else}}
                                    <img src="systems/ptu/static/images/svg/chat.svg" title="Send {{feat.name}} to chat" alt="Chat">
                                {{/if}}
                            </div>
                        </div>
                        <div class="name">{{feat.name}}</div>
                        {{#if feat.frequency}}<div class="freq-tag">{{shortFrequency feat}}</div>{{/if}}
                        {{#if (gt feat.actionCostIcons.length 0)}}
                        <div class="action-costs">
                            {{#each feat.actionCostIcons}}<ptu-icon src="{{this.src}}" title="{{this.label}}" class="cost-icon" alt="{{this.label}}"></ptu-icon>{{/each}}
                        </div>
                        {{/if}}
                        {{#if feat.usageDisplay}}<div class="usage-badge">{{#if feat.usageDisplay.limited}}<span>{{feat.usageDisplay.remaining}}/{{feat.usageDisplay.max}} Uses</span>{{/if}}{{#if feat.usageDisplay.eot}}<span>EOT</span>{{/if}}</div>{{/if}}
                    </div>
                </div>
            {{/each}}
            {{/if}}

            {{#if (and show.abilities (gt abilities.length 0))}}
            {{#each abilities as |ability|}}
                <div class="action ability {{#if ability.rollable}}rollable{{else}}sendtochat{{/if}} {{#if ability.onCooldown}}on-cooldown{{/if}}" data-id="{{ability.id}}"
                    data-tooltip="{{ability.effect}}" data-tooltip-direction="LEFT">
                    <div class="row-main">
                        <div class="icon-wrap">
                            <img class="move-img" src="{{ability.img}}" alt="{{ability.name}}">
                            <div class="dice-overlay">
                                {{#if ability.rollable}}
                                    <img src="/icons/svg/d20.svg" title="Roll {{ability.name}}" alt="Roll">
                                {{else}}
                                    <img src="systems/ptu/static/images/svg/chat.svg" title="Send {{ability.name}} to chat" alt="Chat">
                                {{/if}}
                            </div>
                        </div>
                        <div class="name">{{ability.name}}</div>
                        {{#if ability.frequency}}<div class="freq-tag">{{shortFrequency ability}}</div>{{/if}}
                        {{#if (gt ability.actionCostIcons.length 0)}}
                        <div class="action-costs">
                            {{#each ability.actionCostIcons}}<ptu-icon src="{{this.src}}" title="{{this.label}}" class="cost-icon" alt="{{this.label}}"></ptu-icon>{{/each}}
                        </div>
                        {{/if}}
                        {{#if ability.usageDisplay}}<div class="usage-badge">{{#if ability.usageDisplay.limited}}<span>{{ability.usageDisplay.remaining}}/{{ability.usageDisplay.max}} Uses</span>{{/if}}{{#if ability.usageDisplay.eot}}<span>EOT</span>{{/if}}</div>{{/if}}
                    </div>
                </div>
            {{/each}}
            {{/if}}


            {{#if (and show.edges (gt edges.length 0))}}
            {{#each edges as |edge|}}
                <div class="action edge {{#if edge.rollable}}rollable{{else}}sendtochat{{/if}} {{#if edge.onCooldown}}on-cooldown{{/if}}" data-id="{{edge.id}}"
                    data-tooltip="{{edge.effect}}" data-tooltip-direction="LEFT">
                    <div class="row-main">
                        <div class="icon-wrap">
                            <img class="move-img" src="{{edge.img}}" alt="{{edge.name}}">
                            <div class="dice-overlay">
                                {{#if edge.rollable}}
                                    <img src="/icons/svg/d20.svg" title="Roll {{edge.name}}" alt="Roll">
                                {{else}}
                                    <img src="systems/ptu/static/images/svg/chat.svg" title="Send {{edge.name}} to chat" alt="Chat">
                                {{/if}}
                            </div>
                        </div>
                        <div class="name">{{edge.name}}</div>
                        {{#if edge.frequency}}<div class="freq-tag">{{shortFrequency edge}}</div>{{/if}}
                        {{#if (gt edge.actionCostIcons.length 0)}}
                        <div class="action-costs">
                            {{#each edge.actionCostIcons}}<ptu-icon src="{{this.src}}" title="{{this.label}}" class="cost-icon" alt="{{this.label}}"></ptu-icon>{{/each}}
                        </div>
                        {{/if}}
                        {{#if edge.usageDisplay}}<div class="usage-badge">{{#if edge.usageDisplay.limited}}<span>{{edge.usageDisplay.remaining}}/{{edge.usageDisplay.max}} Uses</span>{{/if}}{{#if edge.usageDisplay.eot}}<span>EOT</span>{{/if}}</div>{{/if}}
                    </div>
                </div>
            {{/each}}
            {{/if}}

            {{#if (and show.capabilities (gt capabilities.length 0))}}
            {{#each capabilities as |capability|}}
                <div class="action capability {{#if capability.rollable}}rollable{{else}}sendtochat{{/if}} {{#if capability.onCooldown}}on-cooldown{{/if}}" data-id="{{capability.id}}"
                    data-tooltip="{{capability.effect}}" data-tooltip-direction="LEFT">
                    <div class="row-main">
                        <div class="icon-wrap">
                            <img class="move-img" src="{{capability.img}}" alt="{{capability.name}}">
                            <div class="dice-overlay">
                                {{#if capability.rollable}}
                                    <img src="/icons/svg/d20.svg" title="Roll {{capability.name}}" alt="Roll">
                                {{else}}
                                    <img src="systems/ptu/static/images/svg/chat.svg" title="Send {{capability.name}} to chat" alt="Chat">
                                {{/if}}
                            </div>
                        </div>
                        <div class="name">{{capability.name}}</div>
                        {{#if capability.frequency}}<div class="freq-tag">{{shortFrequency capability}}</div>{{/if}}
                        {{#if (gt capability.actionCostIcons.length 0)}}
                        <div class="action-costs">
                            {{#each capability.actionCostIcons}}<ptu-icon src="{{this.src}}" title="{{this.label}}" class="cost-icon" alt="{{this.label}}"></ptu-icon>{{/each}}
                        </div>
                        {{/if}}
                        {{#if capability.usageDisplay}}<div class="usage-badge">{{#if capability.usageDisplay.limited}}<span>{{capability.usageDisplay.remaining}}/{{capability.usageDisplay.max}} Uses</span>{{/if}}{{#if capability.usageDisplay.eot}}<span>EOT</span>{{/if}}</div>{{/if}}
                    </div>
                </div>
            {{/each}}
            {{/if}}

            {{#if (and show.items (or (gt items.balls.length 0) (gt items.other.length 0)))}}
            {{#if (gt items.balls.length 0)}}
            {{#each items.balls as |ball|}}
                <div class="action item pokeball {{#if ball.rollable}}rollable{{else}}sendtochat{{/if}} {{#if ball.onCooldown}}on-cooldown{{/if}}" data-id="{{ball.id}}"
                    data-tooltip="{{ball.system.effect}}" data-tooltip-direction="LEFT">
                    <div class="icon">
                        <img class="icon" src="{{ball.img}}" alt="{{ball.name}}">
                        {{#if ball.rollable}}
                            <img class="dice" src="/icons/svg/d20.svg" title="Roll {{ball.name}}">
                        {{else}}
                            <img class="dice" src="systems/ptu/static/images/svg/chat.svg" title="Send {{ball.name}} to chat">
                        {{/if}}
                    </div>
                    <div class="name">
                        {{ball.name}}
                    </div>
                    <div class="usage-badge"><span>{{ball.system.quantity}} Remaining</span></div>
                </div>
            {{/each}}
            {{/if}}
            {{#if (gt items.other.length 0)}}
            {{#each items.other as |item|}}
                <div class="action item other {{#if item.rollable}}rollable{{else}}sendtochat{{/if}} {{#if item.onCooldown}}on-cooldown{{/if}}" data-id="{{item.id}}"
                    data-tooltip="{{item.effect}}" data-tooltip-direction="LEFT">
                    <div class="icon">
                        <img class="icon" src="{{item.img}}" alt="{{item.name}}">
                        {{#if item.rollable}}
                            <img class="dice" src="/icons/svg/d20.svg" title="Roll {{item.name}}">
                        {{else}}
                            <img class="dice" src="systems/ptu/static/images/svg/chat.svg" title="Send {{item.name}} to chat">
                        {{/if}}
                    </div>
                    <div class="name">
                        {{item.name}}
                    </div>
                </div>
            {{/each}}
            {{/if}}
            {{/if}}
        </div>
    </div>

    {{!-- Nav --}}
    <div class="tab-strip">
        

        {{#if (or (gt attacks.length 0) (gt struggles.length 0))}}
            <div class="tab-strip-tab {{#if show.actions}}active{{else}}inactive{{/if}}" data-target="actions">
                <i class="fas fa-burst"></i>
                <span class="tab-label">Moves</span>
            </div>
        {{/if}}
        
        
        {{#if (is actor.type "character")}}
        {{#if (gt feats.length 0)}}
            <div class="tab-strip-tab {{#if show.feats}}active{{else}}inactive{{/if}}" data-target="feats">
                <i class="fas fa-crown"></i>
                <span class="tab-label">Feats</span>
            </div>
        {{/if}}
        {{/if}}


        {{#if (gt abilities.length 0)}}
            <div class="tab-strip-tab {{#if show.abilities}}active{{else}}inactive{{/if}}" data-target="abilities">
                <i class="fas fa-star"></i>
                <span class="tab-label">Abil.</span>
            </div>
        {{/if}}
            
        
        {{#if (gt edges.length 0)}}
            <div class="tab-strip-tab {{#if show.edges}}active{{else}}inactive{{/if}}" data-target="edges">
                <i class="fas fa-rhombus"></i>
                <span class="tab-label">Edges</span>
            </div>
        {{/if}}

        {{#if (gt capabilities.length 0)}}
            <div class="tab-strip-tab {{#if show.capabilities}}active{{else}}inactive{{/if}}" data-target="capabilities">
                <i class="fas fa-arrow-up"></i>
                <span class="tab-label">Capa.</span>
            </div>
        {{/if}}
        
        
        {{#if (is actor.type "character")}}
        {{#if (or (gt items.balls.length 0) (gt items.other.length 0))}}
            <div class="tab-strip-tab {{#if show.items}}active{{else}}inactive{{/if}}" data-target="items">
                <i class="fas fa-backpack"></i>
                <span class="tab-label">Items</span>
            </div>
        {{/if}}
        {{/if}}

        <div class="tab-strip-minimize" title="{{#if minimized}}Expand Token Panel{{else}}Minimize Token Panel{{/if}}">
            <i class="fas {{#if minimized}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
        </div>
        {{#if user.isGM}}
        <button class="frequency-reset-scene" title="Reset Scene Uses" type="button"><i class="fas fa-undo"></i> Scene</button>
        <button class="frequency-reset-daily" title="Reset Daily Uses" type="button"><i class="fas fa-undo"></i> Daily</button>
        {{/if}}
    </div>

    {{#if (or party.trainer (gt conditions.length 0) (gt effects.length 0))}}
    <div class="top-panel">
        <div class="top-panel-toggle" data-target="party">
            {{!-- <span class="toggle-label">Party</span> --}}
            <i class="fas {{#if show.party}}fa-chevron-right{{else}}fa-chevron-left{{/if}}"></i>
        </div>
        {{#if show.party}}
            {{#if party.trainer}}
                <div class="block party-overview">
                    <h5 class="header">Party</h5>
                    {{#unless party.isTrainer}}
                        <img class="trainer icon" data-id="{{party.trainer.id}}" src="{{party.trainer.img}}" alt="{{party.trainer.name}}" draggable="true">
                    {{/unless}}
                    {{#if (gt party.pokemon.length 0)}}
                        <div class="party-pokemon">
                            {{#each party.pokemon as |pokemon|}}
                                <div class="pokemon" data-id="{{pokemon.id}}" style="--health-percent: {{calcHeight pokemon.system.health.percent}}px;">
                                    <img class="{{#if (lte pokemon.system.health.percent 0)}}black{{else}}{{#if (lt pokemon.system.health.percent 25)}}darkred{{else}}{{#if (lt pokemon.system.health.percent 50)}}red{{else}}{{#if (lt pokemon.system.health.percent 75)}}orange{{else}}{{#if (is pokemon.system.health.percent 100)}}green{{else}}lime{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}"
                                        src="{{pokemon.img}}" 
                                        alt="{{pokemon.name}}"
                                        draggable="true"
                                        data-id="{{pokemon.id}}">
                                </div>
                            {{/each}}
                        </div>
                    {{/if}}
                </div>
            {{/if}}
            {{#if (gt conditions.length 0)}}
                <div class="block conditions">
                    <h5 class="header">Conditions</h5>
                    {{#each conditions as |condition|}}
                        <div class="condition" data-actor-id="{{condition.parent.id}}" data-item-id="{{condition.id}}" {{#if condition.system.effect}}title="{{condition.system.effect}}"{{/if}}>
                            <img class="icon" src="{{condition.img}}" alt="{{condition.name}}">
                            <span class="name">{{condition.name}}</span>
                        </div>
                    {{/each}}
                </div>
            {{/if}}
            {{#if (and (gt conditions.length 0) (gt effects.length 0))}}
                <hr>
            {{/if}}
            {{#if (gt effects.length 0)}}
                <div class="block effects">
                    <h5 class="header">Effects</h5>
                    {{#each effects as |effect|}}
                        <div class="effect" data-actor-id="{{effect.parent}}" data-item-id="{{effect.id}}" {{#if effect.effect}}title="{{effect.effect}}"{{/if}}>
                            <img class="icon" src="{{effect.img}}" alt="{{effect.name}}">
                            <span class="name">{{effect.name}}</span>
                        </div>
                    {{/each}}
                </div>
            {{/if}}
        {{/if}}
    </div>
    {{/if}}
    {{/if}}
</section>

