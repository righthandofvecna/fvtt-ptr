<section class="token-panel">
    {{#if actor}}
    <div class="main-panel">
        <div class="avatar {{#if (eq actor.type "pokemon")}}pokemon{{/if}}">
            <img src="{{actor.img}}" alt="{{actor.name}}">
                {{!-- <div class="action">
                    <i class="fas fa-play" title="Standard Action"></i>
                </div>
                <div class="action">
                    <i class="fas fa-arrows-alt" title="Shift Action"></i>
                </div>
                <div class="action">
                    <i class="fas fa-asterisk" title="Rapid Action"></i>
                </div> --}}
        </div>
        <div class="action-bar movement">
            {{#each movement as |move|}}
                <div class="movement-card">
                    <i class="{{move.icon}}" title="{{move.name}}"></i> {{move.value}}
                </div>
            {{/each}}
        </div>
        <div class="separator"></div>
        {{> systems/ptu/static/templates/partials/token-panel/items-body-partial.hbs}}
    </div>

    {{!-- Nav --}}
    <div class="tab-strip">
        {{> systems/ptu/static/templates/partials/token-panel/tab-strip-tabs-partial.hbs}}
        <div class="tab-strip-undock" title="Pop out Token Panel">
            <i class="fas fa-up-right-from-square"></i>
        </div>
        <div class="tab-strip-minimize" title="{{#if minimized}}Expand Token Panel{{else}}Minimize Token Panel{{/if}}">
            <i class="fas {{#if minimized}}fa-chevron-up{{else}}fa-chevron-down{{/if}}"></i>
        </div>
    </div>

    {{#if (or party.trainer (gt conditions.length 0) (gt effects.length 0))}}
    <div class="top-panel">
        <div class="top-panel-toggle" data-target="party">
            {{!-- <span class="toggle-label">Party</span> --}}
            <i class="fas {{#if show.party}}fa-chevron-right{{else}}fa-chevron-left{{/if}}"></i>
        </div>
        {{#if show.party}}
            {{> systems/ptu/static/templates/partials/token-panel/status-blocks-partial.hbs}}
        {{/if}}
    </div>
    {{/if}}
    {{/if}}
</section>

