{{#if data.title.show}}
<header class="journal-page-header">
    <h{{data.title.level}}>{{data.name}}</h{{data.title.level}}>
</header>
{{/if}}
<section class="journal-page-content">
    {{{editor.content}}}
</section>
{{#if rules.cards.length}}
<div class="rules-view-section">
    <div class="rules-view-title">{{localize "PTU.RuleElement.Title"}}</div>
    <div class="rules-view-list">
        {{#each rules.cards}}
        <span class="rule-badge">
            {{label}}{{#if rule.label}} <span class="rule-badge-name">{{rule.label}}</span>{{/if}}
        </span>
        {{/each}}
    </div>
</div>
{{/if}}
