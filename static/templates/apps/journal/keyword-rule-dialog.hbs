<form class="keyword-rule-dialog" autocomplete="off">
    <div class="rule-body" data-key="{{rule.key}}" data-idx="{{index}}">
        {{{ruleTemplate}}}
    </div>
    <div class="form-footer flexrow">
        <button type="button" data-action="save-rule" class="bright">
            <i class="fas fa-save"></i> {{localize "Save Changes"}}
        </button>
    </div>
</form>
