{{#if hasAP}}
<div class="item-row">
    <label for="system.ap.cost">{{localize "ITEM.AP"}}</label>
    <input class="ml-1 mr-1" name="system.ap.cost" type="number" value="{{item.system.ap.cost}}" placeholder="0" min="0" {{#if editLocked}}disabled{{/if}}/>
    {{#if item.system.ap.cost}}
    <input type="checkbox" name="system.ap.bind" {{checked item.system.ap.bind}} {{#if editLocked}}disabled{{/if}}/><label class="unit">{{localize "ITEM.APBind"}}</label>
    {{/if}}
