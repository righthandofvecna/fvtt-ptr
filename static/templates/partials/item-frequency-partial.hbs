<div class="item-row">
    <label for="system.frequency.type">{{localize "ITEM.Frequency"}}</label>
    <select class="ml-1 mr-1" name="system.frequency.type" {{#if editLocked}}disabled{{/if}}>
        {{selectOptions config.frequencies selected=item.system.frequency.type localize=true}}
    </select>
    {{#if (or (is item.system.frequency.type "scene") (is item.system.frequency.type "daily"))}}
    <input class="ml-1 frequency" name="system.frequency.max" type="number" value="{{item.system.frequency.max}}" style="flex: 0.25;" min="1" {{#if editLocked}}disabled{{/if}}/><label class="unit">Max Uses</label>
    <input class="ml-1 used" name="flags.ptu.used" type="number" value="{{item.flags.ptu.used}}" style="flex: 0.25;" min="0" max="{{item.system.frequency.max}}" {{#if editLocked}}disabled{{/if}}/><label class="unit">Used</label>
    {{/if}}
    {{#if (is item.system.frequency.type "custom")}}
    <input class="ml-1 custom-frequency" name="system.frequency.custom" type="text" value="{{item.system.frequency.custom}}" placeholder="Custom Frequency" {{#if editLocked}}disabled{{/if}}/>
    {{/if}}
</div>
<div class="item-row">
    <label>{{localize "ITEM.ActionCost"}}</label>
    <div class="d-flex ml-1" style="gap: 0.5rem; flex-wrap: wrap;">
        <label class="action-cost-label" data-tooltip="PTU.ActionCost.Standard">
          <input type="checkbox" name="system.actionCost.standard" {{checked item.system.actionCost.standard}} {{#if editLocked}}disabled{{/if}}/>
          <img class="icon-svg" src="systems/ptu/static/images/icons/StandardAction.svg" alt=""/>
